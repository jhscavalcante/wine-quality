# ============================================================
#  Wine Quality Project — Environment Variables Template
#  Copy this file to .env and fill in with real values
#  NEVER commit the actual .env file to the repository
# ============================================================

# ── Supabase (Wine Data Source) ──────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
SUPABASE_PROJECT=your-project-name
SUPABASE_PROJECT_ID=your-project-id
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# ── PostgreSQL (if using local DB) ──────────────────────────
POSTGRES_DB=wine_db
POSTGRES_USER=wine_user
POSTGRES_PASSWORD=strong_password

# ── FastAPI ──────────────────────────────────────────────────
API_SECRET_KEY=your-secret-key-here
MODEL_PATH=models/best_model.pkl

# ── DagsHub / MLflow ─────────────────────────────────────────
# Create at: https://dagshub.com → Settings → Tokens
DAGSHUB_USERNAME=your-dagshub-username
DAGSHUB_REPO_NAME=wine-quality
DAGSHUB_TOKEN=your-dagshub-token-here

# ── MLflow Experiment ────────────────────────────────────────
MLFLOW_EXPERIMENT=wine-quality
MLFLOW_MODEL_NAME=wine-quality
MLFLOW_TRACKING_URI=https://dagshub.com/your-username/wine-quality.mlflow

# ── Render/Production ────────────────────────────────────────
PORT=8501
ENVIRONMENT=production

# ── Streamlit ────────────────────────────────────────────────
API_URL=http://localhost:8000

# ── Kaggle (Dataset Download) ───────────────────────────────
KAGGLE_USERNAME="your-kaggle-username"
KAGGLE_KEY="your-kaggle-key-here"

# ── Application Environment ───────────────────────────────────
ENV=production
LOG_LEVEL=INFO
ALLOW_LOCAL_FALLBACK=false

# ── Database Connection ───────────────────────────────────────
DB_STARTUP_RETRIES=3
