# ============================================================
#  Wine Quality Project — Environment Variables Template
#  Copy this file to .env and fill in with real values
#  NEVER commit the actual .env file to the repository
# ============================================================

# ── Supabase (Wine Data Source) ──────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-key-here
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
SUPABASE_PROJECT=your-project-name
SUPABASE_PROJECT_ID=your-project-id
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
# Tabelas usadas por ingestion / logs (valores padrão entre parênteses no código)
SUPABASE_TABLE=wine_quality
SUPABASE_PREDICTIONS_TABLE=wine_predictions

# ── PostgreSQL (if using local DB) ──────────────────────────
POSTGRES_DB=wine_db
POSTGRES_USER=wine_user
POSTGRES_PASSWORD=strong_password

# ── FastAPI ──────────────────────────────────────────────────
API_SECRET_KEY=your-secret-key-here
# Caminho do bundle em disco (treino salva em models/best_model.pkl). Em produção com
# MODEL_PREFER_REGISTRY=true o carregamento do modelo na API vem do MLflow Registry.
MODEL_PATH=models/best_model.pkl

# ── DagsHub / MLflow ─────────────────────────────────────────
# Create at: https://dagshub.com → Settings → Tokens
DAGSHUB_USERNAME=your-dagshub-username
DAGSHUB_REPO_NAME=wine-quality
DAGSHUB_TOKEN=your-dagshub-token-here

# ── MLflow Experiment ────────────────────────────────────────
MLFLOW_EXPERIMENT=wine-quality
MLFLOW_MODEL_NAME=wine-quality-binary
MLFLOW_TRACKING_URI=https://dagshub.com/your-username/wine-quality.mlflow
# Timeout (s) para mlflow.sklearn.load_model via Registry (evita travar o startup)
MLFLOW_MODEL_LOAD_TIMEOUT_SEC=120
# Produção: carregar modelo SOMENTE do MLflow Registry (sem fallback local).
MODEL_PREFER_REGISTRY=true

# ── Render / Docker (gateway nginx) ───────────────────────────
# Render define PORT automaticamente (porta onde nginx escuta no container).
# Docker local: use `docker compose up` (PORT=8080 no compose) ou omita PORT no .env.
# NÃO use PORT=8501 com nginx — quebra o proxy (valor antigo de Streamlit em dev).
ENVIRONMENT=production
# PORT=8080

# ── Streamlit ────────────────────────────────────────────────
# Dev local (passo 5 do README): deixe apontando para a API na mesma máquina.
# No container, start.sh define API_URL=http://127.0.0.1:8001 automaticamente.
API_URL=http://localhost:8000

# ── Kaggle (Dataset Download) ───────────────────────────────
KAGGLE_USERNAME="your-kaggle-username"
KAGGLE_KEY="your-kaggle-key-here"

# ── Application Environment ───────────────────────────────────
ENV=production
LOG_LEVEL=INFO
ALLOW_LOCAL_FALLBACK=false

# ── Database Connection ───────────────────────────────────────
DB_STARTUP_RETRIES=3
